# ---------------------------------------------------------------
# SCHULHUB BS – Beispiel-Konfiguration
# Kopiere diese Datei zu ".env" (lokal) bzw. trage die Werte in
# Vercel unter "Settings → Environment Variables" ein.
# NIEMALS echte Werte in Git hochladen!
# ---------------------------------------------------------------

# WebUntis-Server deiner Schule, nur der Hostname (z. B. xyz.webuntis.com).
# So findest du ihn: siehe README → "WebUntis einrichten".
WEBUNTIS_SERVER=

# Schulname, wie er in der WebUntis-Adresse hinter "?school=" steht.
WEBUNTIS_SCHOOL=

# Zufälliger, geheimer Schlüssel (mind. 32 Zeichen) zum Verschlüsseln des Sitzungs-Cookies.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Kontakt für den Fahrplandienst Transitous (Pflicht laut Nutzungsbedingungen):
# eine E-Mail-Adresse oder die URL deines GitHub-Repos.
TRANSIT_CONTACT=

# Adresse des IServ-Portals (wird nur als Link angezeigt).
ISERV_URL=https://sp-gs.de
